# ──────────────────────────────────────────────────────────────────────────────
#  AI-Powered Study Buddy — Environment Variables
#  Copy this file to .env and fill in real values. Never commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# MySQL connection for the backend (async, aiomysql driver)
DATABASE_URL=mysql+aiomysql://study_user:study_pass@db:3306/study_buddy

# Raw MySQL credentials used by docker-compose to provision the db container
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=study_buddy
MYSQL_USER=study_user
MYSQL_PASSWORD=changeme_user

# ── Clerk Authentication ───────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LLM / AI Configuration ────────────────────────────────────────────────────
# API key for your LLM provider (OpenAI, Together AI, Groq, etc.)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use (default: gpt-4o-mini — fast and cheap for study tasks)
LLM_MODEL=gpt-4o-mini

# (Optional) Override the OpenAI base URL for compatible providers
# Examples:
#   Together AI: https://api.together.xyz/v1
#   Groq:        https://api.groq.com/openai/v1
#   Ollama:      http://localhost:11434/v1
LLM_BASE_URL=

# ── File Storage ──────────────────────────────────────────────────────────────
# Path where uploaded documents are stored (absolute or relative to /app)
STORAGE_PATH=./uploads

# Maximum upload file size in megabytes
MAX_FILE_SIZE_MB=50

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for cross-origin requests
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Maximum API requests per IP per minute
RATE_LIMIT_PER_MINUTE=60

# ── Application ───────────────────────────────────────────────────────────────
# Environment: development | production | test
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
